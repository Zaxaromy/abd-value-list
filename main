<script>
/* ===== CHARACTER LIST =====
   Each character is one line:  ["Name","Rarity",value,"Demand","up","image"],
   The image (last item) is optional. Paste a data: image address there, e.g. "data:image/png;base64,iVBOR..."
   (published pages can only show embedded images, not links to other websites).
   Write values as plain numbers with no comma (40000, not 40,000).
   Rarity: Exclusive, Limited, Divine, Void, Secret, Godly, Mythic, Legendary, Epic, Rare or Common.
   Demand: "High", "Medium" or "Low".  Trend: "up", "stable" or "down".
   The Values page shows characters in the SAME ORDER as this list. */
var CHARACTERS=[
/* Exclusive */
["Tozi","Exclusive",40000,"Very High","up"],
["Kaniko Kakuja","Exclusive",20000,"High","up"],
["Eskanor","Exclusive",19000,"Medium","down"],
/* Limited */
["Yuto","Limited",17000,"High","stable"],
["Mahyto","Limited",12500,"High","stable"],
["Alukard","Limited",12500,"High","up"],
["Madoro","Limited",85000,"Very High","up"],
["Grimjo","Limited",9000,"Medium","up"],
["Kenjako","Limited",9500,"High","up"],
["Muzon","Limited",10500,"Medium","up"],
["Hakary","Limited",130000,"Very High","up"],
["Daveed","Limited",115000,"Very High","up"],
["Neferpito","Limited",7000,"Medium","stable"],
/* Divine */
["Loofy Gear 5","Divine",2500,"Medium","stable"],
["Guko Ultra Instinct","Divine",3000,"Medium","stable"],
["Nurato Six Paths","Divine",3000,"Medium","stable"],
["Ichiru Mugetsu","Divine",3000,"Medium","stable"]
/* Examples for other rarities (move above the closing bracket to use):
["Void Example","Void",1100,"Medium","stable"],
["Secret Example","Secret",1050,"Medium","up"],
["Godly Example","Godly",1000,"High","up"],
["Shadow Striker","Mythic",950,"High","up"],
["Flame Ace","Mythic",820,"High","up"],
["Storm Rally","Legendary",610,"Medium","down"],
["Blade Server","Legendary",540,"High","up"],
["Frost Guard","Legendary",470,"Medium","up"],
["Thunder Pitch","Epic",320,"Medium","down"],
["Wind Runner","Epic",260,"Low","down"],
["Iron Wall","Epic",210,"Medium","up"],
["Spark Kid","Rare",90,"Low","down"],
["Rookie Hero","Common",40,"Low","up"]
*/
];
/* Rarity order, pill background and text colour. Edit colours here. */
var RARITIES=[["Exclusive","#1b1740","#ffd23f"],["Limited","#9f1e2d","#ffffff"],["Divine","#e8d68a","#3f381d"],["Void","#734dbb","#ffffff"],["Secret","#d6336f","#ffffff"],["Godly","#5cb8a6","#08231d"],["Mythic","#da5123","#ffffff"],["Legendary","#d8aa3a","#2b2108"],["Epic","#8f4fba","#ffffff"],["Rare","#3c77ac","#ffffff"],["Common","#6db379","#0f2a16"]];
var RMAP={};RARITIES.forEach(function(r){RMAP[r[0].toLowerCase()]=r});
function $(i){return document.getElementById(i)}
RARITIES.forEach(function(r){var o=document.createElement("option");o.textContent=r[0];o.value=r[0];$("vr").appendChild(o)});
var TIERS={S:["Shadow Striker","Flame Ace"],A:["Storm Rally","Blade Server","Frost Guard"],B:["Thunder Pitch","Iron Wall","Wind Runner"],C:["Spark Kid"],D:["Rookie Hero"]};
var TCOL={S:"#ff4f7b",A:"#ff9f43",B:"#ffd23f",C:"#7bd88f",D:"#8fb8ff"};
var TRAITS=[["Rally Boost","Raises hit power the longer a rally lasts."],["Quick Recovery","Shortens ability cooldowns after each hit."],["Perfect Timing","Widens the window for a strong return."],["Lucky Spin","Improves your odds on future rolls."],["Heavy Hitter","Adds raw power to every hit."],["Steady Hands","Reduces mistimed hits when under pressure."]];
var ads=[{n:"KaiPlays",h:"Storm Rally",w:"Blade Server"},{n:"MiraX",h:"Spark Kid + Wind Runner",w:"Frost Guard"}];
/* IMAGE REPLACEMENT: put a path or URL for any key below, e.g.
   IMAGES["Shadow Striker"]="images/shadow-striker.png"; IMAGES.hero="images/hero.png";
   Keys: hero, each character name, "trait:Trait Name". Empty = placeholder. */
var IMAGES={};
CHARACTERS.forEach(function(c){if(c[5])IMAGES[c[0]]=c[5]});
function esc(s){var d=document.createElement("div");d.textContent=s;return d.innerHTML}
function ph(label){var t=label.length>24?label.slice(0,23)+"…":label;var s="<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 200'><rect width='200' height='200' fill='#d9d4f7'/><circle cx='100' cy='72' r='30' fill='#a79ee6'/><path d='M40 160c0-34 27-52 60-52s60 18 60 52z' fill='#a79ee6'/><text x='100' y='186' font-family='sans-serif' font-size='13' text-anchor='middle' fill='#4a4287'>"+esc(t)+"</text></svg>";return "data:image/svg+xml,"+encodeURIComponent(s)}
function im(key,label,cls){return "<img class='"+cls+"' src='"+(IMAGES[key]||ph(label))+"' alt='"+esc(label)+"' loading='lazy'>"}
function renderValues(){
 var q=$("vq").value.toLowerCase(),r=$("vr").value.toLowerCase(),s=$("vs").value;
 var l=CHARACTERS.filter(function(c){return c[0].toLowerCase().indexOf(q)>-1&&(!r||String(c[1]).toLowerCase()===r)});
 if(s==="n")l.sort(function(a,b){return a[0].localeCompare(b[0])});
 else if(s==="v")l.sort(function(a,b){return b[2]-a[2]});
 $("vbody").innerHTML=l.length?l.map(function(c){var rc=RMAP[String(c[1]).toLowerCase()];return "<tr><td><div class='who'>"+im(c[0],c[0],"thumb")+"<strong>"+esc(c[0])+"</strong></div></td><td><span class='pill'"+(rc?" style='background:"+rc[1]+";color:"+rc[2]+"'":"")+">"+(rc?rc[0]:esc(String(c[1])))+"</span></td><td>"+Number(c[2]).toLocaleString("en-US")+"</td><td>"+c[3]+"</td><td class='"+c[4]+"'>"+(c[4]==="up"?"\u25b2 Rising":c[4]==="stable"?"\u25cf Stable":"\u25bc Falling")+"</td></tr>"}).join(""):"<tr><td colspan='5'>No characters match. Try a different search or rarity.</td></tr>";
}
function renderAds(){
 $("ads").innerHTML=ads.map(function(a){return "<div class='card ad'><strong>"+esc(a.n)+"</strong><div class='swap'><span class='chip'>"+esc(a.h)+"</span><span class='arrow'>⇄</span><span class='chip'>"+esc(a.w)+"</span></div></div>"}).join("");
}
function load(){try{var s=localStorage.getItem("abads");if(s){var p=JSON.parse(s);if(Array.isArray(p))ads=p}}catch(e){}}
function save(){try{localStorage.setItem("abads",JSON.stringify(ads))}catch(e){}}
$("tpost").onclick=function(){
 var n=$("tn").value.trim(),h=$("th").value.trim(),w=$("tw").value.trim();
 if(!n||!h||!w){alert("Fill in your username, what you’re offering and what you want.");return}
 ads.unshift({n:n,h:h,w:w});save();renderAds();$("th").value="";$("tw").value="";
};
["vq","vr","vs"].forEach(function(i){$(i).addEventListener("input",renderValues)});
$("tierlist").innerHTML=Object.keys(TIERS).map(function(t){return "<div class='tier'><strong style='background:"+TCOL[t]+"'>"+t+"</strong><div>"+TIERS[t].map(function(c){return "<figure class='fig'>"+im(c,c,"thumb")+"<figcaption>"+c+"</figcaption></figure>"}).join("")+"</div></div>"}).join("");
$("traitlist").innerHTML=TRAITS.map(function(t){return "<div class='card'>"+im("trait:"+t[0],t[0],"icon")+"<h3>"+t[0]+"</h3><p>"+t[1]+"</p></div>"}).join("");
var PAGES=["home","values","trade-ads","tiers","traits","game"];
function route(){
 var h=(location.hash||"#home").slice(1);if(PAGES.indexOf(h)<0)h="home";
 PAGES.forEach(function(p){$(p).classList.toggle("on",p===h)});
 document.querySelectorAll("#nav a").forEach(function(a){a.classList.toggle("on",a.getAttribute("href")==="#"+h)});
 window.scrollTo(0,0);
}
document.addEventListener("click",function(e){
 var a=e.target.closest&&e.target.closest("a[href^='#']");
 if(!a)return;
 e.preventDefault();
 var h=a.getAttribute("href");
 if(location.hash!==h){try{history.pushState(null,"",h)}catch(x){location.hash=h}}
 route();
});
window.addEventListener("hashchange",route);
$("heroimg").src=IMAGES.hero||ph("Hero image");
load();renderValues();renderAds();route();
</script>
